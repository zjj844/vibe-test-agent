# 复制成 .env 再填（.env 已被 gitignore）
#   Windows: copy .env.example .env

# ---- 生成测试用例 / 自评需要的模型 ----
DEEPSEEK_API_KEY=sk-把你的key写在这里
DEEPSEEK_MODEL=deepseek-v4-pro
# 生成用例用快模型（实测：flash 思考 1447 token / 13 秒；pro 思考 4425 token / 61 秒）
QA_GEN_MODEL=deepseek-flash
QA_JUDGE_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 代理（需要访问外网时才填；本机地址会自动绕过）----
HTTP_PROXY=
HTTPS_PROXY=
