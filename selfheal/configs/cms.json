{
  "name": "cms",
  "base_url": "http://127.0.0.1:8080/cms/",
  "health": {
    "id": "article-page"
  },
  "endpoints": [
    {
      "id": "article-page",
      "method": "GET",
      "path": "/api/article/page",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg",
        "data"
      ],
      "notes": "文章分页查询，支持标题模糊/分类/状态组合条件，需要登录"
    },
    {
      "id": "article-detail",
      "method": "GET",
      "path": "/api/article/1",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg",
        "data"
      ],
      "notes": "查询文章详情并将浏览量+1，需要登录"
    },
    {
      "id": "auth-login",
      "method": "POST",
      "path": "/api/auth/login",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg",
        "data"
      ],
      "notes": "用户登录，返回 Token 与用户信息，无需登录",
      "body": {
        "username": "admin",
        "password": "123456"
      },
      "expect_json": {
        "code": 200
      }
    },
    {
      "id": "auth-info",
      "method": "GET",
      "path": "/api/auth/info",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg",
        "data"
      ],
      "notes": "获取当前登录用户的信息（含角色与权限编码），需要登录"
    },
    {
      "id": "category-tree",
      "method": "GET",
      "path": "/api/category/tree",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg",
        "data"
      ],
      "notes": "查询多级内容分类树，需要登录"
    },
    {
      "id": "log-page",
      "method": "GET",
      "path": "/api/log/page",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg",
        "data"
      ],
      "notes": "操作日志分页查询，支持按用户名/模块/内容关键字过滤，需要登录且具备 log:page 权限"
    },
    {
      "id": "user-page",
      "method": "GET",
      "path": "/api/user/page",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg",
        "data"
      ],
      "notes": "用户分页查询（含角色信息），仅管理员，需要登录且具备 user:page 权限"
    },
    {
      "id": "article-page-anon",
      "method": "GET",
      "path": "/api/article/page",
      "expect_status": 200,
      "expect_fields": [
        "code",
        "msg"
      ],
      "expect_json": {
        "code": 401
      },
      "no_auth": true,
      "notes": "鉴权边界：不带 token 访问文章分页必须被拒绝（HTTP 200 + body.code=401），且 data 为 null"
    }
  ],
  "auth": {
    "endpoint": "auth-login",
    "token_path": "data.token",
    "header": "Authorization",
    "prefix": "Bearer "
  },
  "requirements_dir": "selfheal/requirements_docs/cms"
}
